{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nosueltos/bodyProfile.schema.json",
  "title": "BodyProfileDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "units",
    "segments",
    "reach",
    "joints",
    "biomech",
    "sim"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "mass",
        "force"
      ],
      "properties": {
        "length": {
          "const": "m"
        },
        "mass": {
          "const": "kg"
        },
        "force": {
          "const": "N"
        }
      }
    },
    "segments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "torso",
        "pelvis",
        "head",
        "upperArm",
        "forearm",
        "hand",
        "thigh",
        "shin",
        "foot"
      ],
      "properties": {
        "torso": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "mass"
          ],
          "properties": {
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "pelvis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "mass"
          ],
          "properties": {
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "head": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius",
            "mass"
          ],
          "properties": {
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "upperArm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "mass"
          ],
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "forearm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "mass"
          ],
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "hand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius",
            "mass"
          ],
          "properties": {
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "thigh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "mass"
          ],
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "shin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "mass"
          ],
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "foot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius",
            "mass"
          ],
          "properties": {
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "reach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comfortRatio",
        "hardLimitRatio"
      ],
      "properties": {
        "comfortRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "hardLimitRatio": {
          "type": "number",
          "exclusiveMinimum": 1,
          "maximum": 1.6
        }
      }
    },
    "joints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elbow",
        "knee",
        "shoulder",
        "hip",
        "neck"
      ],
      "properties": {
        "elbow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minAngle",
            "maxAngle",
            "stiffness"
          ],
          "properties": {
            "minAngle": {
              "type": "number",
              "minimum": -0.2,
              "maximum": 3.2
            },
            "maxAngle": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3.3
            },
            "stiffness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "knee": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minAngle",
            "maxAngle",
            "stiffness"
          ],
          "properties": {
            "minAngle": {
              "type": "number",
              "minimum": -0.2,
              "maximum": 3.2
            },
            "maxAngle": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3.3
            },
            "stiffness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "shoulder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minAngle",
            "maxAngle",
            "stiffness"
          ],
          "properties": {
            "minAngle": {
              "type": "number",
              "minimum": -0.2,
              "maximum": 3.2
            },
            "maxAngle": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3.3
            },
            "stiffness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "hip": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minAngle",
            "maxAngle",
            "stiffness"
          ],
          "properties": {
            "minAngle": {
              "type": "number",
              "minimum": -0.2,
              "maximum": 3.2
            },
            "maxAngle": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3.3
            },
            "stiffness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "neck": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minAngle",
            "maxAngle",
            "stiffness"
          ],
          "properties": {
            "minAngle": {
              "type": "number",
              "minimum": -0.2,
              "maximum": 3.2
            },
            "maxAngle": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3.3
            },
            "stiffness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "biomech": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comfortableLoadRatio",
        "overloadRatio",
        "overloadGraceSeconds",
        "overloadAccumRate",
        "overloadDecayRate",
        "effortRate",
        "recoveryRate",
        "recoveryLoadRatio",
        "strengthFactorMin",
        "strengthFactorMax",
        "fatigueFactorMin",
        "posturePenalty",
        "loadEstimatorGain",
        "stabilityWeights",
        "comSpreadReference",
        "comDistanceReference"
      ],
      "properties": {
        "comfortableLoadRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overloadRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "overloadGraceSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "overloadAccumRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "overloadDecayRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "effortRate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thresholdLow",
            "slopeLow",
            "thresholdHigh",
            "slopeHigh",
            "postureWeight"
          ],
          "properties": {
            "thresholdLow": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "slopeLow": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "thresholdHigh": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "slopeHigh": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "postureWeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "recoveryRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recoveryLoadRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "strengthFactorMin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2
        },
        "strengthFactorMax": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "fatigueFactorMin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "posturePenalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "loadEstimatorGain": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stabilityWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "support",
            "spread",
            "com",
            "load"
          ],
          "properties": {
            "support": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "spread": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "com": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "load": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "comSpreadReference": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "comDistanceReference": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "sim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gravity",
        "damping",
        "iterations",
        "fixedDeltaSeconds",
        "resetSettleSeconds",
        "tremorAmplitude"
      ],
      "properties": {
        "gravity": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "damping": {
          "type": "number",
          "exclusiveMinimum": 0.8,
          "maximum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "fixedDeltaSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "resetSettleSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "tremorAmplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        }
      }
    }
  }
}
