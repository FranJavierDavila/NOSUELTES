{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nosueltos/manifest.schema.json",
  "title": "ContentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "characters",
    "bodyProfiles",
    "walls",
    "challenges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bodyProfiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
