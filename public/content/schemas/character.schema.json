{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nosueltos/character.schema.json",
  "title": "CharacterDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "bodyProfileId",
    "virtues",
    "physical",
    "control"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "bodyProfileId": {
      "type": "string",
      "minLength": 1
    },
    "virtues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "endurance",
        "flexibility"
      ],
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "endurance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flexibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "massScale",
        "reachScale",
        "baseGripForce"
      ],
      "properties": {
        "massScale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2
        },
        "reachScale": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.25
        },
        "baseGripForce": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "legForceFactor": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gripAssist",
        "targetFollowStrength",
        "holdSnapRadius"
      ],
      "properties": {
        "gripAssist": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "targetFollowStrength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "holdSnapRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "presentation": {
      "type": "object"
    }
  }
}